{
  "name": "Prompt to Poster (DevFest 2026)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Prompt to Poster",
        "formDescription": "Pitch a talk idea, pick a vibe, and get a promo card in seconds. Please don't enter names or personal info.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Talk title",
              "placeholder": "Teaching Robots to Salsa",
              "requiredField": true
            },
            {
              "fieldLabel": "Topic",
              "fieldType": "textarea",
              "placeholder": "What is the talk about? One or two sentences.",
              "requiredField": true
            },
            {
              "fieldLabel": "Vibe",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "retro"
                  },
                  {
                    "option": "minimal"
                  },
                  {
                    "option": "cosmic"
                  },
                  {
                    "option": "playful"
                  },
                  {
                    "option": "bold"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Make my poster 🎨",
          "path": "prompt-to-poster"
        }
      },
      "name": "Talk idea form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "3001952f-0efa-47e3-98a8-5be880e22a83",
      "id": "d4dc0a95-aa26-4813-b48b-fafbbdc43cb2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aiplatform.googleapis.com/v1/projects/gdg-workflow-512920/locations/global/publishers/google/models/gemini-3.8-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"systemInstruction\": {\n    \"parts\": [{ \"text\": \"You are an art director who designs promo cards for tech conference talks, and the safety reviewer for a family-friendly tech event. First decide if the idea is appropriate. Set is_appropriate to false if the title or topic includes, mentions, or hints at: politics of any kind (elections, voting, candidates, politicians, political parties, government policy, protests, or the recent mayoral election); hate, slurs, or insults about any person or group; harassment or mocking of real people; sexual content; violence, weapons, or self-harm; drugs; or anything else not suitable for a family tech event. Treat misspellings, symbols, and coded words (for example tr*mp or p0litics) the same as the real words. When in doubt, set is_appropriate to false. reason: one short sentence explaining your decision. If is_appropriate is false, set headline, tagline, and image_prompt to empty strings. If is_appropriate is true, write: headline: a punchy headline, 8 words max. It can be the title or a sharper version of it. tagline: one sentence, 15 words max, that makes people want to attend. image_prompt: art direction for an image model, 60 to 100 words. Describe the subject, art style, color palette, lighting, and composition. Match the vibe. Keep the main subject in the upper two thirds of the frame. Rules for image_prompt: no text, letters, numbers, or words in the image. No logos or brand marks. No people at all; use objects, robots, animals, landscapes, or abstract shapes instead. Keep it safe for a family audience.\" }]\n  },\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{ \"text\": {{ JSON.stringify('Talk title: ' + $json['Talk title'] + '\\nTopic: ' + $json['Topic'] + '\\nVibe: ' + $json['Vibe']) }} }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.9,\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"OBJECT\",\n      \"properties\": {\n        \"is_appropriate\": { \"type\": \"BOOLEAN\", \"description\": \"false if the idea breaks any safety rule\" },\n        \"reason\": { \"type\": \"STRING\", \"description\": \"One short sentence explaining the decision\" },\n        \"headline\": { \"type\": \"STRING\", \"description\": \"8 words max. Empty if not appropriate.\" },\n        \"tagline\": { \"type\": \"STRING\", \"description\": \"15 words max. Empty if not appropriate.\" },\n        \"image_prompt\": { \"type\": \"STRING\", \"description\": \"Art direction for the image model. No text, logos, or people. Empty if not appropriate.\" }\n      },\n      \"required\": [\"is_appropriate\", \"reason\", \"headline\", \"tagline\", \"image_prompt\"],\n      \"propertyOrdering\": [\"is_appropriate\", \"reason\", \"headline\", \"tagline\", \"image_prompt\"]\n    }\n  }\n}",
        "options": {}
      },
      "name": "Gemini - write copy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "id": "488adafe-a65a-480b-815e-0875aaed075b"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "headline",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).headline }}"
            },
            {
              "id": "a2",
              "name": "tagline",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).tagline }}"
            },
            {
              "id": "a3",
              "name": "image_prompt",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).image_prompt }}"
            },
            {
              "id": "a4",
              "name": "vibe",
              "type": "string",
              "value": "={{ $('Talk idea form').item.json['Vibe'] }}"
            },
            {
              "id": "96dfcb11-1dd9-4877-85f3-18820f2ab211",
              "name": "is_appropriate",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).is_appropriate }}",
              "type": "boolean"
            },
            {
              "id": "e328e86c-d95a-4876-b3ae-ccc46ddeff1d",
              "name": "reason",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).reason }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Read Gemini copy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        0
      ],
      "id": "ee19b0b4-ac32-4aa2-b925-1b0d0334c992"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aiplatform.googleapis.com/v1/projects/gdg-workflow-512920/locations/global/publishers/google/models/gemini-3.1-flash-image:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{ \"text\": {{ JSON.stringify($json.image_prompt) }} }]\n  }],\n  \"generationConfig\": {\n    \"responseModalities\": [\"TEXT\", \"IMAGE\"],\n    \"imageConfig\": { \"aspectRatio\": \"3:4\" }\n  }\n}",
        "options": {}
      },
